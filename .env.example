# ==========================================
# NOTX Platform - Environment Configuration
# ==========================================

# Firebase Client Configuration (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Admin SDK Configuration (Server-side API routes)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, wrap the key in quotes and replace literal newlines with \n if single line
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Backblaze B2 S3-Compatible Storage Configuration
# Endpoint format: s3.<region>.backblazeb2.com (e.g. s3.us-east-005.backblazeb2.com)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=notx-deliverables
# Key ID (Application Key ID from Backblaze B2 App Keys)
B2_KEY_ID=your_b2_key_id_here
# Application Key (Master or application secret key from Backblaze B2)
B2_APPLICATION_KEY=your_b2_application_key_here

# App URL (Optional, defaults to localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
